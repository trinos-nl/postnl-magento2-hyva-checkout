<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="cart.summary">
            <block name="cart_before"
                   template="PostNL_HyvaCheckout::cart/button.phtml"
                   before="checkout.cart.methods.bottom"
                   ifconfig="tig_postnl/fillin/settings/cart/enabled">
                <arguments>
                    <argument name="view_model" xsi:type="object">TIG\PostNL\ViewModel\FillIn</argument>
                </arguments>
            </block>
            <block name="cart_after"
                   template="PostNL_HyvaCheckout::cart/button.phtml"
                   after="checkout.cart.methods.bottom"
                   ifconfig="tig_postnl/fillin/settings/cart/enabled">
                <arguments>
                    <argument name="view_model" xsi:type="object">TIG\PostNL\ViewModel\FillIn</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
