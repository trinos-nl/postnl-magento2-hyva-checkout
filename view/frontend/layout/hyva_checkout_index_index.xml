<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hyva_checkout_components"/>
    <body>
        <referenceBlock name="entity-form.field-renderers">
            <block name="form-field.postnl_container.address"
                   as="postnl_address"
                   template="PostNL_HyvaCheckout::form/field/nl-fields.phtml"
            >
                <block name="component-messenger-address-auto-complete"
                       as="messenger"
                       template="Hyva_Checkout::page/messenger.phtml"
                >
                    <arguments>
                        <argument name="event_prefix" xsi:type="string">address:postnl-validation</argument>
                    </arguments>
                </block>
            </block>
        </referenceBlock>

        <referenceContainer name="hyva.checkout.api-v1.after">
            <block name="hyva.checkout.postnl-autocomplete"
                   template="PostNL_HyvaCheckout::checkout/page/js/nl-address.phtml"
            />
        </referenceContainer>

        <block name="before_email"
               template="PostNL_HyvaCheckout::cart/button.phtml"
               before="checkout.cart.methods.bottom">
            <arguments>
                <argument name="view_model" xsi:type="object">TIG\PostNL\ViewModel\FillIn</argument>
                <argument name="hyva_js_block_dependencies" xsi:type="array">
                    <item name="postnl.button.js.loader" xsi:type="boolean">true</item>
                </argument>
            </arguments>
        </block>

        <block name="before_detail"
               template="PostNL_HyvaCheckout::cart/button.phtml"
               before="checkout.cart.methods.bottom">
            <arguments>
                <argument name="view_model" xsi:type="object">TIG\PostNL\ViewModel\FillIn</argument>
                <argument name="hyva_js_block_dependencies" xsi:type="array">
                    <item name="postnl.button.js.loader" xsi:type="boolean">true</item>
                </argument>
            </arguments>
        </block>

        <move element="before_email" destination="checkout.guest-details.section" before="-"/>
        <move element="before_detail" destination="checkout.shipping-details.section"
              after="checkout.shipping-details.title"/>
    </body>
</page>
