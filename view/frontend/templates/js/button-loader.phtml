<?php
declare(strict_types=1);

/** @var $block Magento\Framework\View\Element\Template */
/** @var $hyvaCsp Hyva\Theme\ViewModel\HyvaCsp */
/** @var $viewModel TIG\PostNL\ViewModel\FillIn */

$viewModel = $block->getViewModel();
$defaultCountry = $viewModel->getDefaultCountry();
$shippingCountry = $viewModel->getShippingCountry();
?>

    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('postnlComponent', () => ({
                fillInUrl: window.location.origin + '/postnl/fillin/index',
                isVisible: false,
                isDisabled: false,
                isLoading: false,
                country_id: '<?= $shippingCountry ?>',
                defaultCountry: '<?= $defaultCountry ?>',
                redirectUrl: '',
                cart: null,
                cartCount: 0,
                reloadTimer: null,

                // Initialization function on x-init
                initialize() {
                    if (!window.hyva) window.hyva = {};
                    window.dispatchEvent(new Event('reload-customer-section-data'));

                    document.querySelector('.product-info button, .items-start button')?.addEventListener('click', async () => {
                        try {
                            await fetch('/checkout/cart/add', {
                                method: 'POST',
                                body: new FormData(document.querySelector('.product-info button, .items-start button')),
                            });
                        } catch (e) {
                            console.error('Add to Cart failed', e);
                        }

                        window.dispatchEvent(new Event('reload-customer-section-data'));
                    });

                    if (document.body.classList.contains('checkout-cart-index')) {
                        this.initCartData();
                        this.observeCountrySelect();
                    } else if (document.body.classList.contains('hyva_checkout-index-index')) {
                        this.observeCountrySelect();
                    } else {
                        this.initCartData();
                    }
                },

                // Listen for 'private-content-loaded' to update cart data, and initial cart data load
                initCartData() {
                    window.addEventListener('private-content-loaded', (event) => {
                        this.receiveSectionData(event.detail.data);
                    });

                    window.dispatchEvent(new Event('reload-customer-section-data'));
                },

                receiveSectionData(data) {
                    if (data && data.cart) {
                        this.cart = data.cart;
                        this.cartCount = data.cart.summary_count || 0;
                        this.$nextTick(() => {
                            this.isVisible = this.cartCount >= 1;
                        });
                    }
                },

                refreshCartData() {
                    clearTimeout(this.reloadTimer);
                    this.reloadTimer = setTimeout(() => {
                        window.dispatchEvent(new Event('reload-customer-section-data'));
                    }, 200);
                },

                // Observe the country select dropdown for changes in the cart page or checkout
                observeCountrySelect() {
                    this.$watch('country_id', (newValue) => {
                        this.toggleVisibility(newValue);
                    });

                    const check = () => {
                        const select = document.querySelector('select[name="country_id"]');
                        if (select && select.offsetParent !== null) {
                            this.country_id = select.value;
                            this.toggleVisibility(select.value);

                            select.addEventListener('change', () => {
                                this.country_id = select.value;
                                this.toggleVisibility(select.value);
                            });
                        } else {
                            setTimeout(check, 300);
                        }
                    };
                    check();
                },

                // Method to handle visibility logic
                updateVisibility() {
                    if (!this.country_id || this.country_id !== 'NL') {
                        this.isVisible = this.defaultCountry === 'NL';
                    } else {
                        this.isVisible = true;
                    }
                },

                // Toggle visibility based on selected country
                toggleVisibility(value) {
                    this.isVisible = value === 'NL';
                },

                // Handle the button click to complete the action
                handleClick() {
                    if (!this.fillInUrl) return;

                    this.isLoading = true;
                    this.isDisabled = true;

                    fetch(this.fillInUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: JSON.stringify({
                            country_id: this.country_id || this.defaultCountry,
                        }),
                    })
                        .then(async response => {
                            if (!response.ok) {
                                const text = await response.text();
                                console.error('Bad response:', text);
                                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                            }

                            const contentType = response.headers.get('Content-Type') || '';
                            if (!contentType.includes('application/json')) {
                                const text = await response.text();
                                console.error('Unexpected non-JSON response:', text);
                                throw new Error('Expected JSON response from server');
                            }

                            return response.json();
                        })
                        .then(data => {
                            if (data.redirect_url) {
                                window.location.href = data.redirect_url;
                            } else if (data.success) {
                                console.log('Success:', data.message || 'Action completed successfully.');
                            } else {
                                console.warn('Unexpected data structure:', data);
                            }
                        })
                        .catch(error => {
                            console.error('Fetch Error:', error);
                        })
                        .finally(() => {
                            this.isLoading = false;
                            this.isDisabled = false;
                        });
                },

                // Handle success response
                handleSuccess(response) {
                    if (response.redirect_url) {
                        window.location.href = response.redirect_url;
                    }
                },

                // Handle error response
                handleError(error) {
                    console.error('Error:', error);
                }

            }));
        });
    </script>

<?php if (isset($hyvaCsp)) $hyvaCsp->registerInlineScript() ?>
